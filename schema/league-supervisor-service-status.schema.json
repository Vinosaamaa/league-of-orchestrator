{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://league-of-orchestrator.invalid/schema/league-supervisor-service-status.schema.json",
  "title": "League multiplex persistent supervisor service status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "live", "event_driven", "binding_count", "bindings", "monitor_live"],
  "properties": {
    "schema": {"const": "league.supervisor-service-status.v1"},
    "live": {"type": "boolean"},
    "event_driven": {"const": true},
    "binding_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["callsign", "actor_agent_id", "squad_id", "live", "monitor_live"],
        "properties": {
          "callsign": {"type": "string", "minLength": 1},
          "actor_agent_id": {"type": "string", "minLength": 1},
          "squad_id": {"type": "string", "minLength": 1},
          "fence": {"type": "integer", "minimum": 1},
          "notification_policy": {"enum": ["all_material", "calm"]},
          "attachment_mode": {"enum": ["attached", "detached"]},
          "live": {"type": "boolean"},
          "monitor_live": {"type": "boolean"},
          "reason": {"enum": ["registration_missing", "process_unreachable"]}
        }
      }
    },
    "lease_seconds": {"type": "number", "exclusiveMinimum": 0},
    "recovery_seconds": {"type": "number", "exclusiveMinimum": 0},
    "monitor_live": {"type": "boolean"},
    "stopped": {"type": "boolean"}
  }
}

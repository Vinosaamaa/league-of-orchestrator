{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vinosaamaa/league-of-orchestrator/schema/league-shotcaller-handoff-plan.schema.json",
  "title": "League Shotcaller handoff plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scope",
    "authority",
    "non_goals",
    "unresolved",
    "pending_decisions",
    "next_actions",
    "obligations",
    "policy_digest",
    "instruction_digest",
    "expires_at",
    "page_bound"
  ],
  "properties": {
    "schema": {"const": "league.shotcaller-handoff-plan.v1"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"const": "squad"},
        "id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "authority": {"type": "string", "minLength": 1, "maxLength": 4096},
    "non_goals": {"$ref": "#/$defs/boundedTextList"},
    "unresolved": {"$ref": "#/$defs/boundedTextList"},
    "pending_decisions": {"$ref": "#/$defs/boundedTextList"},
    "next_actions": {"$ref": "#/$defs/boundedTextList"},
    "obligations": {"$ref": "#/$defs/boundedTextList"},
    "policy_digest": {"type": "string", "minLength": 1, "maxLength": 256},
    "instruction_digest": {"type": "string", "minLength": 1, "maxLength": 256},
    "expires_at": {"type": "string", "format": "date-time"},
    "page_bound": {"type": "integer", "minimum": 1, "maximum": 500}
  },
  "$defs": {
    "boundedTextList": {
      "type": "array",
      "maxItems": 500,
      "items": {"type": "string", "maxLength": 4096}
    }
  }
}

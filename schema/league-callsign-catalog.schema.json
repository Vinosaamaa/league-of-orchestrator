{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vinosaamaa/league-of-orchestrator/schema/league-callsign-catalog.schema.json",
  "title": "League complete callsign catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["callsign", "enabled", "capabilities"],
        "properties": {
          "callsign": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"},
          "enabled": {"type": "boolean"},
          "capabilities": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"}
          }
        }
      }
    }
  }
}

#!/bin/sh
set -eu
PYTHONDONTWRITEBYTECODE=1
export PYTHONDONTWRITEBYTECODE
script_path=$0
while [ -L "$script_path" ]; do
  link_target=$(readlink "$script_path")
  case $link_target in
    /*) script_path=$link_target ;;
    *) script_path=$(dirname -- "$script_path")/$link_target ;;
  esac
done
script_dir=$(CDPATH= cd -P -- "$(dirname -- "$script_path")" && pwd)
project_root=$(CDPATH= cd -P -- "$script_dir/.." && pwd)
pointer=${LEAGUE_WRITER_POINTER:-"${HOME:-/nonexistent}/.local/state/league-writer-pointer.json"}
if [ -f "$pointer" ] && grep -q '"writer":"sqlite"' "$pointer"; then
  LEAGUE_WRITER_POINTER=$pointer
  export LEAGUE_WRITER_POINTER
  if [ -z "${LEAGUE_STATE_ROOT:-}" ]; then
    LEAGUE_STATE_ROOT=$(dirname -- "$pointer")/league
    export LEAGUE_STATE_ROOT
  fi
  PYTHONPATH="$project_root/src${PYTHONPATH:+:$PYTHONPATH}"
  export PYTHONPATH
  exec python3 -m league.canonical_watcher "$@"
fi
exec python3 "$project_root/src/agent_watcher.py" "$@"

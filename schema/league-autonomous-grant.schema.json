{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vinosaamaa/league-of-orchestrator/schema/league-autonomous-grant.schema.json",
  "title": "Immutable scoped autonomous-delivery grant",
  "type": "object",
  "required": ["schema", "grant_id", "goal_id", "issuer", "shotcaller_agent_id", "exact_goal", "scope", "allowed_actions", "exclusions", "sensitive_inclusions", "resource_boundary", "starts_at", "expires_at", "limits", "revision"],
  "properties": {
    "schema": {"const": "league.autonomous-grant.v1"},
    "grant_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "goal_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "issuer": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {"kind": {"const": "summoner"}, "id": {"type": "string", "minLength": 1, "maxLength": 256}},
      "additionalProperties": false
    },
    "shotcaller_agent_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "exact_goal": {"type": "string", "minLength": 1, "maxLength": 4096},
    "scope": {
      "type": "object",
      "required": ["project_ids", "repositories", "environments", "deployment_targets"],
      "properties": {
        "project_ids": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 256}, "uniqueItems": true},
        "repositories": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 256}, "uniqueItems": true},
        "environments": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 256}, "uniqueItems": true},
        "deployment_targets": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 256}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "allowed_actions": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"enum": ["land", "merge", "release", "publish", "install", "deploy", "verify", "smoke", "repair", "cleanup", "issue_reopen", "live_reconcile", "retire", "shotcaller_create", "squad_register", "teardown"]}, "uniqueItems": true},
    "exclusions": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 256}, "uniqueItems": true},
    "sensitive_inclusions": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 256}, "uniqueItems": true},
    "resource_boundary": {"$ref": "#/$defs/resourceObject"},
    "starts_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "limits": {
      "type": "object",
      "required": ["max_attempts", "max_concurrency", "max_cost_microunits", "max_changed_files", "max_duration_seconds", "max_repair_attempts"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1},
        "max_concurrency": {"type": "integer", "minimum": 1},
        "max_cost_microunits": {"type": "integer", "minimum": 1},
        "max_changed_files": {"type": "integer", "minimum": 1},
        "max_duration_seconds": {"type": "integer", "minimum": 1},
        "max_repair_attempts": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "revision": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "resourceObject": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {"minLength": 1, "maxLength": 256},
      "additionalProperties": {"$ref": "#/$defs/resourceValue"}
    },
    "resourceValue": {
      "anyOf": [
        {"type": "string", "maxLength": 4096},
        {"type": "number"},
        {"type": "boolean"},
        {"type": "null"},
        {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/resourceValue"}},
        {"$ref": "#/$defs/resourceObject"}
      ]
    }
  },
  "additionalProperties": false
}

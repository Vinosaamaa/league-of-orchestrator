{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vinosaamaa/league-of-orchestrator/schema/league-rollover-drain-receipt.schema.json",
  "title": "League post-switch predecessor drain receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "verified", "operation_id", "predecessor_agent_id", "successor_agent_id", "owner_event_id", "archive_digest", "resource_receipt_digest", "callsign_release_receipt_digest"],
  "properties": {
    "schema": {"const": "league.rollover-drain-receipt.v1"},
    "verified": {"const": true},
    "operation_id": {"type": "string", "minLength": 1},
    "predecessor_agent_id": {"type": "string", "minLength": 1},
    "successor_agent_id": {"type": "string", "minLength": 1},
    "owner_event_id": {"type": "string", "minLength": 1},
    "archive_digest": {"type": "string", "minLength": 1},
    "resource_receipt_digest": {"type": "string", "minLength": 1},
    "callsign_release_receipt_digest": {"type": "string", "minLength": 1}
  }
}

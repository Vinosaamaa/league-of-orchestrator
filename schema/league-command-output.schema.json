{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vinosaamaa/league-of-orchestrator/schema/league-command-output.schema.json",
  "title": "League command result envelope",
  "type": "object",
  "required": ["schema", "ok", "command"],
  "properties": {
    "schema": {"const": "league.command.v1"},
    "ok": {"type": "boolean"},
    "command": {
      "type": "string",
      "pattern": "^[a-z][a-z-]*\\.[a-z][a-z-]*$"
    },
    "result": {},
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 512},
        "retryable": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"ok": {"const": true}}},
      "then": {"required": ["result"], "not": {"required": ["error"]}},
      "else": {"required": ["error"], "not": {"required": ["result"]}}
    }
  ],
  "additionalProperties": false
}

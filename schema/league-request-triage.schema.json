{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vinosaamaa/league-of-orchestrator/schema/league-request-triage.schema.json",
  "title": "League complete prompt triage input",
  "type": "array",
  "minItems": 1,
  "maxItems": 32,
  "items": {
    "type": "object",
    "required": ["prompt_item_id", "ordinal", "summary", "disposition", "request_id"],
    "properties": {
      "prompt_item_id": {"type": "string", "minLength": 1},
      "ordinal": {"type": "integer", "minimum": 1, "maximum": 32},
      "summary": {"type": "string", "minLength": 1, "maxLength": 512},
      "disposition": {"enum": ["new_request", "follow_up", "context", "acknowledgement", "duplicate", "deferred"]},
      "request_id": {"type": ["string", "null"], "minLength": 1},
      "next_attention_at": {"type": ["string", "null"], "minLength": 1}
    },
    "allOf": [
      {
        "if": {"properties": {"disposition": {"const": "deferred"}}},
        "then": {"required": ["next_attention_at"]}
      }
    ],
    "additionalProperties": false
  }
}

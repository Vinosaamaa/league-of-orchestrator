{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vinosaamaa/league-of-orchestrator/schema/league-mode-status.schema.json",
  "title": "Scoped autonomous-delivery status",
  "type": "object",
  "required": ["schema", "mode", "goal_id", "goal_state", "grant", "limits", "usage", "next_irreversible_action"],
  "properties": {
    "schema": {"const": "league.mode-status.v1"},
    "mode": {"enum": ["manual", "autonomous_delivery"]},
    "goal_id": {"type": "string", "minLength": 1},
    "goal_state": {"enum": ["awaiting_authority", "implementing", "ready_to_land", "landing", "deploying", "verifying", "repair_pending", "delivered", "cleanup_pending", "cleaned"]},
    "goal_version": {"type": "integer", "minimum": 1},
    "grant": {
      "type": ["object", "null"],
      "required": ["grant_id", "revision", "issuer", "shotcaller_agent_id", "exact_goal", "scope", "allowed_actions", "exclusions", "sensitive_inclusions", "resource_boundary", "starts_at", "expires_at", "canonical_digest", "version", "status"],
      "properties": {
        "grant_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "revision": {"type": "integer", "minimum": 1},
        "issuer": {"type": "object", "required": ["kind", "id"], "properties": {"kind": {"const": "summoner"}, "id": {"type": "string", "minLength": 1, "maxLength": 256}}, "additionalProperties": false},
        "shotcaller_agent_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "exact_goal": {"type": "string", "minLength": 1, "maxLength": 4096},
        "scope": {
          "type": "object",
          "required": ["project_ids", "repositories", "environments", "deployment_targets"],
          "properties": {
            "project_ids": {"$ref": "#/$defs/tokenArray"},
            "repositories": {"$ref": "#/$defs/tokenArray"},
            "environments": {"$ref": "#/$defs/tokenArray"},
            "deployment_targets": {"$ref": "#/$defs/tokenArray"}
          },
          "additionalProperties": false
        },
        "allowed_actions": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"enum": ["land", "merge", "release", "publish", "install", "deploy", "verify", "smoke", "repair", "cleanup", "issue_reopen"]}, "uniqueItems": true},
        "exclusions": {"$ref": "#/$defs/tokenArray"},
        "sensitive_inclusions": {"$ref": "#/$defs/tokenArray"},
        "resource_boundary": {"$ref": "#/$defs/resourceObject"},
        "starts_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "canonical_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "version": {"const": 1},
        "status": {"enum": ["active", "not_started", "expired", "revoked"]}
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1},
        "max_concurrency": {"type": "integer", "minimum": 1},
        "max_cost_microunits": {"type": "integer", "minimum": 1},
        "max_changed_files": {"type": "integer", "minimum": 1},
        "max_duration_seconds": {"type": "integer", "minimum": 1},
        "max_repair_attempts": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "attempts": {"type": "integer", "minimum": 0},
        "cost_microunits": {"type": "integer", "minimum": 0},
        "changed_files": {"type": "integer", "minimum": 0},
        "duration_seconds": {"type": "integer", "minimum": 0},
        "concurrency": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "next_irreversible_action": {"type": "string", "minLength": 1},
    "idempotent": {"type": "boolean"},
    "revocation_receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "tokenArray": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 256}, "uniqueItems": true},
    "resourceObject": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {"minLength": 1, "maxLength": 256},
      "additionalProperties": {"$ref": "#/$defs/resourceValue"}
    },
    "resourceValue": {
      "anyOf": [
        {"type": "string", "maxLength": 4096},
        {"type": "number"},
        {"type": "boolean"},
        {"type": "null"},
        {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/resourceValue"}},
        {"$ref": "#/$defs/resourceObject"}
      ]
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vinosaamaa/league-of-orchestrator/schema/league-mode-action-receipt.schema.json",
  "title": "Autonomous external-action use receipt",
  "type": "object",
  "required": ["schema", "action_use_id", "goal_id", "grant_id", "grant_revision", "action_kind", "external_action_owner", "state", "use_receipt_digest", "result_receipt_digest", "goal_state", "goal_version", "idempotent"],
  "properties": {
    "schema": {"const": "league.mode-action-receipt.v1"},
    "action_use_id": {"type": "string", "minLength": 1},
    "goal_id": {"type": "string", "minLength": 1},
    "grant_id": {"type": "string", "minLength": 1},
    "grant_revision": {"type": "integer", "minimum": 1},
    "action_kind": {"type": "string", "minLength": 1},
    "external_action_owner": {"type": "string", "minLength": 1},
    "state": {"enum": ["in_progress", "succeeded", "failed"]},
    "use_receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_receipt_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "goal_state": {"type": "string", "minLength": 1},
    "goal_version": {"type": "integer", "minimum": 1},
    "idempotent": {"type": "boolean"},
    "repair": {"type": ["object", "null"]}
  },
  "additionalProperties": false
}

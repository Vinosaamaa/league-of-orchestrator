{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vinosaamaa/league-of-orchestrator/schema/agent-update.schema.json",
  "title": "League Roster lifecycle update",
  "type": "object",
  "required": ["at", "status", "update"],
  "properties": {
    "at": {"type": "string", "format": "date-time"},
    "status": {
      "enum": [
        "active",
        "started",
        "working",
        "progress",
        "blocked",
        "completed",
        "complete",
        "cancelled",
        "canceled",
        "failed",
        "ready_to_land"
      ]
    },
    "update": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}

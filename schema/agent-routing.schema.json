{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vinosaamaa/league-of-orchestrator/schema/agent-routing.schema.json",
  "title": "League semantic model routing",
  "type": "object",
  "required": ["schema", "tiers"],
  "properties": {
    "schema": {"enum": [1, 2]},
    "tiers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["model", "effort"],
        "properties": {
          "model": {"type": "string", "minLength": 1},
          "effort": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "evaluations": {
      "type": "object",
      "properties": {
        "WORKER_FAST": {
          "type": "object",
          "required": ["approved", "representative_tasks"],
          "properties": {
            "approved": {"type": "boolean"},
            "representative_tasks": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["quality_baseline", "safe_boundary_escalations"],
      "properties": {
        "quality_baseline": {"const": "WORKER_STRONG"},
        "safe_boundary_escalations": {"const": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vinosaamaa/league-of-orchestrator/schema/league-acceptance-receipt.schema.json",
  "title": "League isolated acceptance receipt",
  "type": "object",
  "required": [
    "schema",
    "version",
    "namespace",
    "home",
    "operation",
    "determinism",
    "sentinels",
    "migration_shadow",
    "staged_install",
    "cutover",
    "canary",
    "adapters",
    "pending_assertions",
    "runtime_claims"
  ],
  "properties": {
    "schema": {"const": "league.acceptance-receipt.v1"},
    "version": {"type": "string", "minLength": 1},
    "namespace": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "home": {"type": "string", "minLength": 1},
    "operation": {"$ref": "#/$defs/acceptanceOperation"},
    "determinism": {
      "type": "object",
      "required": ["clock", "ids_allocated"],
      "properties": {
        "clock": {"type": "string", "format": "date-time"},
        "ids_allocated": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "sentinels": {
      "type": "object",
      "required": ["unchanged", "byte_paths", "config_sha256", "process_sha256", "process_count"],
      "properties": {
        "unchanged": {"const": true},
        "byte_paths": {"type": "integer", "minimum": 1},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "process_sha256": {"$ref": "#/$defs/sha256"},
        "process_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "migration_shadow": {
      "type": "object",
      "required": ["migration", "dry_run", "apply", "exact_parity", "parity_sha256", "legacy_unchanged"],
      "properties": {
        "migration": {"$ref": "#/$defs/migrationReceipt"},
        "dry_run": {
          "type": "object",
          "required": ["eligible", "report_digest", "source_digest", "artifact_counts"],
          "properties": {
            "eligible": {"const": true},
            "report_digest": {"$ref": "#/$defs/sha256"},
            "source_digest": {"$ref": "#/$defs/sha256"},
            "artifact_counts": {
              "type": "object",
              "additionalProperties": {"type": "integer", "minimum": 0}
            }
          },
          "additionalProperties": false
        },
        "apply": {
          "type": "object",
          "required": ["applied", "row_counts"],
          "properties": {
            "applied": {"const": true},
            "row_counts": {
              "type": "object",
              "additionalProperties": {"type": "integer", "minimum": 0}
            }
          },
          "additionalProperties": false
        },
        "exact_parity": {"const": true},
        "parity_sha256": {"$ref": "#/$defs/sha256"},
        "legacy_unchanged": {"const": true}
      },
      "additionalProperties": false
    },
    "staged_install": {
      "type": "object",
      "required": [
        "prefix",
        "version",
        "source_release_staged_parity",
        "source_manifest_sha256",
        "release_manifest_sha256",
        "staged_manifest_sha256",
        "file_count",
        "launcher_resolution",
        "help_checked",
        "schemas_checked",
        "schema_migration",
        "hook_fixtures",
        "permissions_checked",
        "path_leaks",
        "guidance",
        "rollback"
      ],
      "properties": {
        "prefix": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source_release_staged_parity": {"const": true},
        "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "release_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "staged_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1},
        "launcher_resolution": {"const": true},
        "help_checked": {"const": true},
        "schemas_checked": {"type": "integer", "minimum": 1},
        "schema_migration": {
          "type": "object",
          "required": ["to_version", "journal_mode", "integrity"],
          "properties": {
            "to_version": {"type": "integer", "minimum": 1},
            "journal_mode": {"enum": ["DELETE", "WAL"]},
            "integrity": {"const": true}
          },
          "additionalProperties": false
        },
        "hook_fixtures": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/hookFixture"}
        },
        "permissions_checked": {"const": true},
        "path_leaks": {"const": false},
        "guidance": {
          "type": "object",
          "required": [
            "source",
            "target",
            "source_sha256",
            "installed_sha256",
            "prior_sha256",
            "restored_sha256",
            "universal_before_sha256",
            "universal_after_install_sha256",
            "universal_after_rollback_sha256",
            "universal_unchanged",
            "rollback_completed"
          ],
          "properties": {
            "source": {"const": "global-agent-instructions/league/AGENTS.md"},
            "target": {"const": "league/AGENTS.md"},
            "source_sha256": {"$ref": "#/$defs/sha256"},
            "installed_sha256": {"$ref": "#/$defs/sha256"},
            "prior_sha256": {"$ref": "#/$defs/sha256"},
            "restored_sha256": {"$ref": "#/$defs/sha256"},
            "universal_before_sha256": {"$ref": "#/$defs/sha256"},
            "universal_after_install_sha256": {"$ref": "#/$defs/sha256"},
            "universal_after_rollback_sha256": {"$ref": "#/$defs/sha256"},
            "universal_unchanged": {"const": true},
            "rollback_completed": {"const": true}
          },
          "additionalProperties": false
        },
        "rollback": {
          "type": "object",
          "required": ["completed", "restored_target", "observed_version"],
          "properties": {
            "completed": {"const": true},
            "restored_target": {"type": "string", "minLength": 1},
            "observed_version": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "cutover": {
      "type": "object",
      "required": ["pointer_schema", "generation_bound", "exclusive_lock", "crash_recovery_journal", "fault_stages", "cases", "never_two_writers"],
      "properties": {
        "pointer_schema": {"const": "league.writer-pointer.v1"},
        "generation_bound": {"const": true},
        "exclusive_lock": {"const": true},
        "crash_recovery_journal": {"const": true},
        "fault_stages": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {"$ref": "#/$defs/faultStage"}
        },
        "cases": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/cutoverCase"}
        },
        "never_two_writers": {"const": true}
      },
      "additionalProperties": false
    },
    "canary": {
      "type": "object",
      "required": ["registered_exactly", "resource_id", "generation", "cleanup_exact", "wrong_generation_refused", "adapter_receipt", "real_runtime_proven"],
      "properties": {
        "registered_exactly": {"const": true},
        "resource_id": {"type": "string", "minLength": 1},
        "generation": {"type": "string", "minLength": 1},
        "cleanup_exact": {"const": true},
        "wrong_generation_refused": {"const": true},
        "adapter_receipt": {"type": "string", "minLength": 1},
        "real_runtime_proven": {"const": false}
      },
      "additionalProperties": false
    },
    "adapters": {
      "type": "object",
      "required": ["harness", "terminal_backend", "git", "github", "process_resource", "notification", "deployment", "hook"],
      "properties": {
        "harness": {"$ref": "#/$defs/adapterReceipt"},
        "terminal_backend": {"$ref": "#/$defs/adapterReceipt"},
        "git": {"$ref": "#/$defs/adapterReceipt"},
        "github": {"$ref": "#/$defs/adapterReceipt"},
        "process_resource": {"$ref": "#/$defs/adapterReceipt"},
        "notification": {"$ref": "#/$defs/adapterReceipt"},
        "deployment": {"$ref": "#/$defs/adapterReceipt"},
        "hook": {"$ref": "#/$defs/adapterReceipt"}
      },
      "additionalProperties": false
    },
    "pending_assertions": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["slice", "issue", "status", "passed", "reason"],
        "properties": {
          "slice": {"enum": ["request", "assignment", "watcher", "stop", "teardown"]},
          "issue": {"type": "integer", "minimum": 1},
          "status": {"const": "pending"},
          "passed": {"const": false},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "runtime_claims": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["runtime", "status", "mock_proof"],
        "properties": {
          "runtime": {"enum": ["codex", "cursor", "pi", "herdr", "tmux"]},
          "status": {"const": "unverified"},
          "mock_proof": {"const": false}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "connectionPolicy": {
      "type": "object",
      "required": ["loaded_sqlite", "journal_mode", "wal_allowed", "wal_refusal", "busy_timeout_ms", "foreign_keys", "synchronous"],
      "properties": {
        "loaded_sqlite": {"type": "string", "minLength": 1},
        "journal_mode": {"const": "DELETE"},
        "wal_allowed": {"const": false},
        "wal_refusal": {"const": "wal_not_requested"},
        "busy_timeout_ms": {"const": 500},
        "foreign_keys": {"const": true},
        "synchronous": {"const": "FULL"}
      },
      "additionalProperties": false
    },
    "migrationReceipt": {
      "type": "object",
      "required": ["schema", "from_version", "to_version", "applied", "backup", "policy"],
      "properties": {
        "schema": {"const": "league.migration.v1"},
        "from_version": {"const": 0},
        "to_version": {"const": 17},
        "applied": {
          "type": "array",
          "prefixItems": [
            {"const": 1}, {"const": 2}, {"const": 3}, {"const": 4},
            {"const": 5}, {"const": 6}, {"const": 7}, {"const": 8},
            {"const": 9}, {"const": 10}, {"const": 11}, {"const": 12},
            {"const": 13}, {"const": 14}, {"const": 15}, {"const": 16},
            {"const": 17}
          ],
          "minItems": 17,
          "maxItems": 17
        },
        "backup": {"type": "null"},
        "policy": {"$ref": "#/$defs/connectionPolicy"}
      },
      "additionalProperties": false
    },
    "acceptanceOperationEntry": {
      "oneOf": [
        {
          "type": "object",
          "required": ["state", "at", "attempt"],
          "properties": {
            "state": {"enum": ["planned", "executing", "completed"]},
            "at": {"type": "string", "format": "date-time"},
            "attempt": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["state", "at", "attempt", "error_code", "resumable"],
          "properties": {
            "state": {"const": "blocked"},
            "at": {"type": "string", "format": "date-time"},
            "attempt": {"type": "integer", "minimum": 1},
            "error_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "resumable": {"const": true}
          },
          "additionalProperties": false
        }
      ]
    },
    "acceptanceOperation": {
      "type": "object",
      "required": ["schema", "namespace", "state", "attempt", "sentinel_sha256", "history"],
      "properties": {
        "schema": {"const": "league.acceptance-operation.v1"},
        "namespace": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
        "state": {"const": "completed"},
        "attempt": {"type": "integer", "minimum": 1},
        "sentinel_sha256": {"$ref": "#/$defs/sha256"},
        "history": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/acceptanceOperationEntry"}
        }
      },
      "additionalProperties": false
    },
    "hookFixture": {
      "type": "object",
      "required": ["harness", "fixture_consumed", "configuration_mutated", "runtime_support_proven"],
      "properties": {
        "harness": {"enum": ["codex", "cursor", "pi"]},
        "fixture_consumed": {"const": true},
        "configuration_mutated": {"const": false},
        "runtime_support_proven": {"const": false}
      },
      "additionalProperties": false
    },
    "faultStage": {
      "enum": [
        "lock_acquired",
        "backup_recorded",
        "old_writer_quiesced",
        "pointer_prepared",
        "pointer_switched",
        "new_writer_activated",
        "generation_verified"
      ]
    },
    "plannedHistory": {
      "type": "object",
      "required": ["state", "at"],
      "properties": {
        "state": {"const": "planned"},
        "at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "executingHistory": {
      "type": "object",
      "required": ["state", "at", "stage"],
      "properties": {
        "state": {"const": "executing"},
        "at": {"type": "string", "format": "date-time"},
        "stage": {
          "oneOf": [
            {"$ref": "#/$defs/faultStage"},
            {"const": "resume"}
          ]
        }
      },
      "additionalProperties": false
    },
    "blockedHistory": {
      "type": "object",
      "required": ["state", "at", "stage", "resumable"],
      "properties": {
        "state": {"const": "blocked"},
        "at": {"type": "string", "format": "date-time"},
        "stage": {"$ref": "#/$defs/faultStage"},
        "resumable": {"const": true}
      },
      "additionalProperties": false
    },
    "completedHistory": {
      "type": "object",
      "required": ["state", "at", "outcome"],
      "properties": {
        "state": {"const": "completed"},
        "at": {"type": "string", "format": "date-time"},
        "outcome": {"enum": ["old", "new"]}
      },
      "additionalProperties": false
    },
    "operationHistory": {
      "oneOf": [
        {"$ref": "#/$defs/plannedHistory"},
        {"$ref": "#/$defs/executingHistory"},
        {"$ref": "#/$defs/blockedHistory"},
        {"$ref": "#/$defs/completedHistory"}
      ]
    },
    "cutoverCase": {
      "type": "object",
      "required": ["fault_stage", "terminal_state", "final_generation", "history", "max_active_writers", "lock_exclusive", "coherent", "journal_state", "startup_reconciled", "process_restart_simulated", "crash_signal", "recovery_exit"],
      "properties": {
        "fault_stage": {"oneOf": [{"$ref": "#/$defs/faultStage"}, {"type": "null"}]},
        "terminal_state": {"enum": ["completed", "blocked"]},
        "final_generation": {"enum": ["generation-old", "generation-new"]},
        "history": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/operationHistory"}},
        "max_active_writers": {"type": "integer", "minimum": 1, "maximum": 1},
        "lock_exclusive": {"const": true},
        "coherent": {"const": true},
        "journal_state": {"enum": ["completed", "reconciled"]},
        "startup_reconciled": {"type": "boolean"},
        "process_restart_simulated": {"type": "boolean"},
        "crash_signal": {"oneOf": [{"const": "SIGKILL"}, {"type": "null"}]},
        "recovery_exit": {"oneOf": [{"const": 0}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "adapterReceipt": {
      "type": "object",
      "required": ["kind", "calls", "real"],
      "properties": {
        "kind": {"type": "string", "pattern": "^fake-"},
        "calls": {"type": "integer", "minimum": 1},
        "real": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

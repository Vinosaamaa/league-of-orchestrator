    },
    {
      "name": "representative evidence downgrade",
      "evaluated": true,
      "signals": {"bounded_checkable": true},
      "at": "2026-08-29T12:00:00-07:00",
      "expected": {"provider": "alpha", "tier": "WORKER_FAST", "reason_code": "evidence_downgrade"}
    },
    {
      "name": "risk retains strongest baseline",
      "evaluated": true,
      "signals": {"bounded_checkable": true, "high_impact": true},
      "at": "2026-08-29T12:00:00-07:00",
      "expected": {"provider": "alpha", "tier": "WORKER_STRONG", "reason_code": "reliability_baseline"}
    },
    {
      "name": "ambiguity retains strongest baseline",
      "evaluated": true,
      "signals": {"bounded_checkable": true, "ambiguity": true},
      "at": "2026-08-29T12:00:00-07:00",
      "expected": {"provider": "alpha", "tier": "WORKER_STRONG", "reason_code": "reliability_baseline"}
    },
    {
      "name": "weak verification retains strongest baseline",
      "evaluated": true,
      "signals": {"bounded_checkable": true, "weak_verification": true},
      "at": "2026-08-29T12:00:00-07:00",
      "expected": {"provider": "alpha", "tier": "WORKER_STRONG", "reason_code": "reliability_baseline"}
    },
    {
      "name": "exact explicit tuple wins",
      "evaluated": true,
      "signals": {"bounded_checkable": true},
      "at": "2026-08-28T12:00:00-07:00",
      "explicit_provider": "beta",
      "explicit_model": "user/exact",
      "explicit_effort": "max",
      "required_capabilities": ["browser"],
      "expected": {"provider": "beta", "model": "user/exact", "effort": "max", "reason_code": "explicit_override"}
    },
    {
      "name": "active dated operator override",
      "evaluated": true,
      "override": true,
      "signals": {"bounded_checkable": true},
      "at": "2026-08-28T12:00:00-07:00",
      "expected": {"provider": "alpha", "model": "alpha/operator-strong", "effort": "xhigh", "reason_code": "operator_override"}
    },
    {
      "name": "expired override falls back then one failure escalates",
      "evaluated": true,
      "override": true,
      "signals": {"bounded_checkable": true},
      "at": "2026-08-29T12:00:00-07:00",
      "expected": {"provider": "alpha", "tier": "WORKER_FAST", "reason_code": "evidence_downgrade"},
      "escalate_failure": "tool_failure",
      "escalated_expected": {"state": "escalated", "tier": "WORKER_STRONG", "reason_code": "failure_escalation", "escalation_count": 1}
    },
    {
      "name": "provider capability fallback",
      "evaluated": true,
      "signals": {"bounded_checkable": true},
      "at": "2026-08-29T12:00:00-07:00",
      "required_capabilities": ["browser"],
      "expected": {"provider": "beta", "reason_code": "provider_capability_fallback"}
    },
    {
      "name": "unsupported capability refuses before selection",
      "evaluated": true,
      "signals": {"bounded_checkable": true},
      "at": "2026-08-29T12:00:00-07:00",
      "required_capabilities": ["audio"],

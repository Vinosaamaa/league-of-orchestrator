{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vinosaamaa/league-of-orchestrator/schema/league-roster-snapshot.schema.json",
  "title": "League bounded read-only project-grouped Roster snapshot",
  "type": "object",
  "required": [
    "schema", "canonical", "read_only", "visibility", "snapshot", "bounds",
    "truncated", "counts", "squads", "projects", "recent_transitions"
  ],
  "properties": {
    "schema": {"const": "league.roster-snapshot.v1"},
    "canonical": {"const": false},
    "read_only": {"const": true},
    "visibility": {"enum": ["local", "outbound"]},
    "snapshot": {
      "type": "object",
      "required": ["as_of", "recent_since", "stale_before", "transaction"],
      "properties": {
        "as_of": {"type": "string", "format": "date-time"},
        "recent_since": {"type": "string", "format": "date-time"},
        "stale_before": {"type": "string", "format": "date-time"},
        "transaction": {"const": "one-bounded-read"}
      },
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "required": ["item_limit", "transition_limit"],
      "properties": {
        "item_limit": {"type": "integer", "minimum": 1, "maximum": 500},
        "transition_limit": {"type": "integer", "minimum": 1, "maximum": 100}
      },
      "additionalProperties": false
    },
    "truncated": {
      "type": "object",
      "required": ["items", "projects", "squads", "transitions"],
      "properties": {
        "items": {"type": "boolean"},
        "projects": {"type": "boolean"},
        "squads": {"type": "boolean"},
        "transitions": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": ["needs_action", "recently_finished", "underway", "unresolved", "projects", "squads"],
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "squads": {"type": "array", "maxItems": 500, "items": {"type": "object"}},
    "projects": {"type": "array", "maxItems": 501, "items": {"$ref": "#/$defs/project_group"}},
    "recent_transitions": {"type": "array", "maxItems": 100, "items": {"type": "object"}}
  },
  "$defs": {
    "project_group": {
      "type": "object",
      "required": ["project", "groups"],
      "properties": {
        "project": {"type": ["object", "null"]},
        "project_key": {"type": "string"},
        "groups": {
          "type": "object",
          "required": ["needs_action", "recently_finished", "underway", "unresolved"],
          "properties": {
            "needs_action": {"type": "array", "items": {"$ref": "#/$defs/item"}},
            "recently_finished": {"type": "array", "items": {"$ref": "#/$defs/item"}},
            "underway": {"type": "array", "items": {"$ref": "#/$defs/item"}},
            "unresolved": {"type": "array", "items": {"$ref": "#/$defs/item"}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": ["kind", "status", "updated_at", "stale", "evidence_links"],
      "properties": {
        "kind": {"enum": ["task", "agent", "request"]},
        "status": {"type": "string"},
        "updated_at": {"type": "string", "format": "date-time"},
        "stale": {"type": "boolean"},
        "evidence_links": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vinosaamaa/league-of-orchestrator/schema/league-rollover-pages.schema.json",
  "title": "League active-Champion snapshot page receipts",
  "type": "object",
  "additionalProperties": false,
  "required": ["pages"],
  "properties": {
    "pages": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["offset", "count", "digest", "rows"],
        "properties": {
          "offset": {"type": "integer", "minimum": 0},
          "count": {"type": "integer", "minimum": 0, "maximum": 500},
          "digest": {"type": "string", "minLength": 1},
          "rows": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["champion_agent_id", "task_id", "callsign", "binding_digest", "row_digest"],
              "properties": {
                "champion_agent_id": {"type": "string", "minLength": 1},
                "task_id": {"type": ["string", "null"]},
                "callsign": {"type": "string", "minLength": 1},
                "binding_digest": {"type": "string", "minLength": 1},
                "row_digest": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vinosaamaa/league-of-orchestrator/schema/league-skill-runtime-profile.schema.json",
  "title": "League skill runtime capability profile",
  "type": "object",
  "required": ["schema", "adapter", "capabilities"],
  "properties": {
    "schema": {"const": "league.skill-runtime-profile.v1"},
    "adapter": {
      "type": "object",
      "required": ["harness", "backend"],
      "properties": {
        "harness": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "backend": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}
      },
      "additionalProperties": false
    },
    "capabilities": {"$ref": "league-skill-contracts.schema.json#/$defs/capabilityMap"}
  },
  "additionalProperties": false
}

#!/bin/sh
set -eu

if [ "$#" -ne 4 ] || [ "$1" != "-p" ] || [ "$3" != "-o" ]; then
  exit 2
fi

pid=$2
field=$4
mode=${LEAGUE_TEST_PS_MODE:-}
marker_root=${LEAGUE_TEST_PS_MARKER_ROOT:-}

if [ -z "$mode" ] || [ -z "$marker_root" ]; then
  exit 2
fi
marker="${marker_root}/league-test-ps-${pid}"

if ! kill -0 "$pid" 2>/dev/null; then
  exit 1
fi

case "$field" in
  lstart=)
    if [ "$mode" = tracked ]; then
      : > "$marker"
    fi
    printf 'PID-%s\n' "$pid"
    ;;
  stat=)
    if [ "$mode" = stable ]; then
      printf 'S\n'
    elif [ "$mode" = tracked ] && [ -f "$marker" ]; then
      rm -f "$marker"
      printf 'S\n'
    else
      # Runtime cleanup asks for stat without a preceding identity read only
      # after sending SIGTERM. Treat that exact test sequence as exited.
      exit 1
    fi
    ;;
  *)
    exit 2
    ;;
esac
